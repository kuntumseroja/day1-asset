# Copy to repo root as .env before ./deploy/aws/deploy.sh

POSTGRES_USER=detp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=detp

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

PACT_BROKER_BASIC_AUTH_USERNAME=pact
PACT_BROKER_BASIC_AUTH_PASSWORD=change-me-pact

# REQUIRED: Elastic IP or domain (no trailing slash)
# Get from EC2 → Elastic IPs after associating with your instance
PUBLIC_URL=http://3.24.xxx.xxx

REPO_URL=https://github.com/kuntumseroja/day1-asset.git
REPO_BRANCH=main
