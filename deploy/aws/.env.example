# Copy to repo root as .env before docker compose up on EC2
POSTGRES_USER=detp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=detp

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

PACT_BROKER_BASIC_AUTH_USERNAME=pact
PACT_BROKER_BASIC_AUTH_PASSWORD=change-me-pact

# Public URL for portal build (Elastic IP or domain, no trailing slash)
PUBLIC_URL=http://13.212.xxx.xxx

# Git repo (override if using fork)
REPO_URL=https://github.com/kuntumseroja/day1-asset.git
REPO_BRANCH=main
