# Local dev (defaults match docker-compose)
# VITE_API_BASE=http://localhost:8093/api/v1
# VITE_RECON_BASE=http://localhost:8085/api/v1
# VITE_WS_URL=ws://localhost:8093/api/v1/ws

# AWS demo — replace with Elastic IP or domain
# VITE_API_BASE=http://13.212.xxx.xxx:8093/api/v1
# VITE_RECON_BASE=http://13.212.xxx.xxx:8085/api/v1
# VITE_WS_URL=ws://13.212.xxx.xxx:8093/api/v1/ws

# AWS with nginx reverse proxy (recommended)
# VITE_API_BASE=http://13.212.xxx.xxx/api/v1
# VITE_RECON_BASE=http://13.212.xxx.xxx/recon/api/v1
# VITE_WS_URL=ws://13.212.xxx.xxx/ws
